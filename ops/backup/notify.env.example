# Store the real file as root:root 0600. No shell expansion.
MAIL_PROVIDER=yandex-postbox
MAIL_FROM=no-reply@uchet-personala.ru
ALERT_TO=m.avanesov@yums.ru
YANDEX_POSTBOX_API_KEY_ID=
YANDEX_POSTBOX_API_KEY_SECRET=
STATE_DIRECTORY=/var/lib/personnel-s3-backup
NOTIFY_STATE_DIRECTORY=/var/lib/personnel-s3-backup-notify
MAX_BACKUP_AGE_HOURS=36
RUNNING_GRACE_HOURS=1
REMINDER_HOURS=24
BACKUP_TIMER=personnel-s3-backup.timer
