DATABASE_URL=postgresql://personnel:personnel@localhost:5432/personnel
# Instead of DATABASE_URL, deployments may use PGHOST, PGPORT, PGUSER,
# PGPASSWORD, and PGDATABASE (useful for mapping PGPASSWORD from Lockbox).
DATABASE_SSL=disable
DATABASE_POOL_SIZE=5
APP_ORIGIN=http://localhost:3000

# Optional: invitation emails through Resend.
RESEND_API_KEY=
MAIL_FROM=Personnel Accounting <access@example.com>

# Server-only Bitrix24 incoming webhook and smart-process field codes.
# Keep the webhook URL in a secret store in production.
BITRIX24_WEBHOOK_URL=
BITRIX24_SYNC_ENABLED=false
BITRIX24_EMPLOYEE_ENTITY_TYPE_ID=182
BITRIX24_EMPLOYEE_NAME_FIELD=title
BITRIX24_EMPLOYEE_TYPE_FIELD=
BITRIX24_EMPLOYEE_DEPARTMENT_FIELD=
BITRIX24_EMPLOYEE_POSITION_FIELD=
BITRIX24_EMPLOYEE_PROJECT_FIELD=
# Keys may be stage IDs or names; values: on_site, transfer, intershift,
# vacation, sick_leave, dismissed, out_of_scope, deleted, unknown.
BITRIX24_STAGE_STATUS_MAP={}
# Only employees from these stages are imported. On-site employees must also
# match one of BITRIX24_INCLUDED_PROJECTS.
BITRIX24_INCLUDED_STAGES=[]
BITRIX24_INCLUDED_PROJECTS=[]
# Optional mapping from Bitrix24 project values/IDs to a project name or code here.
BITRIX24_PROJECT_MAP={}
