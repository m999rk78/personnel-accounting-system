# Literal KEY=value file; no shell expansion. Save the real file with mode 0600.
# The key can upload/read this bucket. Retention additionally needs ListBucketVersions
# and DeleteObjectVersion, scoped to personnel-accounting/production/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.ru-6.storage.selcloud.ru
AWS_DEFAULT_REGION=ru-6
S3_BUCKET=personnel-accounting-backups
S3_PREFIX=personnel-accounting/production
MAX_BACKUP_AGE_HOURS=36
# Enable only after the version-list/delete permissions have been configured.
RETENTION_ENABLED=false

# Optional custom CA bundle. Keep TLS verification enabled.
# S3_CA_BUNDLE=/etc/personnel-s3-backup/s3-ca.pem

# PostgreSQL 18 image used by the verified Selectel backup in November 2026.
# A missing image is fetched by this exact digest; no moving tags or auto-upgrades.
POSTGRES_IMAGE=postgres@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
